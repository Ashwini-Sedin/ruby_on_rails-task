<tr id="<%= dom_id(student) %>" style="border-bottom: 1px solid #eee;">
  <td style="padding: 14px 16px; width: 16%;"><%= student.name %></td>
  <td style="padding: 14px 16px; width: 22%;"><%= student.email %></td>
  <td style="padding: 14px 16px; width: 8%;"><%= student.age %></td>
  <td style="padding: 14px 16px; width: 16%;"><%= student.course %></td>
  <td style="padding: 14px 16px; width: 16%;"><%= student.city %></td>
  <td style="padding: 14px 16px; width: 22%;">
    <%= link_to "View",
        student_path(student),
        data: { turbo_frame: "_top" } %> |
    <%= link_to "Edit",
        edit_student_path(student),
        data: { turbo_frame: "edit_student" } %> |
    
    <%= link_to "Delete",
        student_path(student),
        data: {
          turbo_method: :delete,
          turbo_confirm: "Are you sure?"
        } %>
  </td>
</tr>
